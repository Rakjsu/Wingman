# Keep the working tree identical on every machine.
#
# Without this, a Windows checkout with core.autocrlf=true produces CRLF files,
# while .prettierrc asks for LF — so `prettier --check` passes locally and fails
# in CI. Normalising here fixes both sides at once.
* text=auto eol=lf

# Windows-only tooling that genuinely wants CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Never touch binaries.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.msi   binary
*.exe   binary
*.dll   binary

# Generated; keep diffs quiet in review.
package-lock.json   linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
